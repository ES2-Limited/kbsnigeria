VITE_SUPABASE_URL=https://your-project.supabase.co
# Legacy anon JWT (eyJ...) OR new publishable key (sb_publishable_...) from Dashboard → Settings → API Keys
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server-side only — for scripts/seed-legacy-gallery.mjs (never expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Storage Provider Configuration
# Choose active provider: 'cloudinary' | 'r2' | 'supabase' (defaults to cloudinary if configured, else supabase)
VITE_STORAGE_PROVIDER=cloudinary

# Cloudinary (Frontend unsigned upload)
# In Cloudinary console: Settings -> Upload -> Upload presets -> Add unsigned preset
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
VITE_CLOUDINARY_FOLDER=kbsnigeria

# Cloudflare R2 (When switching to R2)
# R2 Worker or API endpoint for direct upload / presigned PUT URL
VITE_R2_UPLOAD_ENDPOINT=https://your-r2-worker.workers.dev/upload
# Custom domain or public bucket URL for R2 assets
VITE_R2_PUBLIC_URL=https://media.kbsnigeria.com

